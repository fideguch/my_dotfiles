.vim/plugged/*
.DS_Store

# Claude Code runtime artifacts (worktrees, local settings)
.claude/

# Claude Code skill transient artifacts (playwright temp scripts, etc.)
**/.temp-execution-*.js

# bochi S3 hook logs (runtime state, not synced)
claude/logs/

# Codex CLI live config. Codex appends a [projects."<absolute path>"] trust_level
# block for every directory you approve, and those paths carry client / project
# names — this repo is public. Track codex/config.template.toml instead;
# set_up.sh seeds the live file from it.
codex/config.toml
