{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "layout-spec",
  "description": "Measured layout of a reference deck (extract_layout.py output for PPTX; hand-authored from visual measurement for PDF/image references, with confidence 'visual-estimate'). Ground truth for QA #11 via compare_layout.py and sole coordinate source for the PDF/image rebuild route.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "slide_size", "slide_count", "slides", "confidence"],
  "properties": {
    "source": {"type": "string"},
    "slide_size": {
      "type": "object", "additionalProperties": false,
      "required": ["w_in", "h_in"],
      "properties": {"w_in": {"type": "number", "exclusiveMinimum": 0},
                     "h_in": {"type": "number", "exclusiveMinimum": 0}}
    },
    "slide_count": {"type": "integer", "minimum": 1},
    "fonts_used": {"type": "array", "items": {"type": "string"}},
    "colors_used": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "string", "enum": ["measured", "measured-with-warnings", "visual-estimate"]},
    "warning_count": {"type": "integer", "minimum": 0},
    "slides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "shapes"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "part": {"type": "string"},
          "layout": {"type": ["string", "null"]},
          "template_id": {"type": "string", "description": "assigned during R2 template mapping"},
          "background": {
            "type": ["object", "null"], "additionalProperties": false,
            "properties": {"color": {"type": ["string", "null"]},
                           "from": {"type": "string", "enum": ["slide", "layout", "master"]}}
          },
          "show_master_shapes": {"type": "boolean"},
          "shape_count": {"type": "integer", "minimum": 0},
          "decoration_count": {"type": "integer", "minimum": 0},
          "confidence": {"type": "string", "enum": ["measured", "measured-with-warnings", "visual-estimate"]},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "shapes": {"type": "array", "items": {"$ref": "#/definitions/shape"}},
          "decorations": {"type": "array", "items": {"$ref": "#/definitions/shape"}}
        }
      }
    }
  },
  "definitions": {
    "shape": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "x_in", "y_in", "w_in", "h_in", "geometry_from"],
      "properties": {
        "kind": {"type": "string", "enum": ["text", "shape", "image", "table", "graphicFrame", "connector"]},
        "name": {"type": ["string", "null"]},
        "placeholder": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {"type": {"type": "string"}, "idx": {"type": "string"}}
        },
        "geometry_from": {"type": "string", "enum": ["slide", "layout", "master", "layout-deco", "master-deco", "visual"]},
        "layer": {"type": "string", "enum": ["slide", "layout-deco", "master-deco"]},
        "in_group": {"type": "boolean"},
        "x_in": {"type": "number"}, "y_in": {"type": "number"},
        "w_in": {"type": "number", "minimum": 0}, "h_in": {"type": "number", "minimum": 0},
        "rot_deg": {"type": "number"},
        "flip_h": {"type": "boolean"}, "flip_v": {"type": "boolean"},
        "preset": {"type": ["string", "null"]},
        "fill": {"type": ["string", "null"]},
        "line": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {"color": {"type": ["string", "null"]}, "w_pt": {"type": ["number", "null"]}}
        },
        "text": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "first_run": {
              "type": ["object", "null"], "additionalProperties": false,
              "properties": {"size_pt": {"type": ["number", "null"]}, "bold": {"type": "boolean"},
                             "color": {"type": ["string", "null"]}, "font": {"type": ["string", "null"]},
                             "font_ea": {"type": ["string", "null"]},
                             "font_from": {"type": ["string", "null"], "enum": ["run", "theme", null]}}
            },
            "align": {"type": ["string", "null"]},
            "anchor": {"type": ["string", "null"]},
            "wrap": {"type": ["string", "null"]},
            "autofit": {"type": ["string", "null"]},
            "bullets": {"type": "boolean"},
            "paragraphs": {"type": "integer", "minimum": 0},
            "chars": {"type": "integer", "minimum": 0}
          }
        },
        "image": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "target": {"type": ["string", "null"]},
            "srcRect_pct": {
              "type": ["object", "null"], "additionalProperties": false,
              "properties": {"l": {"type": "number"}, "t": {"type": "number"},
                             "r": {"type": "number"}, "b": {"type": "number"}}
            }
          }
        }
      }
    }
  }
}
